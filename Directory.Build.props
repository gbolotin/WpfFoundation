<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Fluent ThemeMode is still marked experimental; every project here uses WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <Authors>gbolotin</Authors>
    <Copyright>Copyright (c) gbolotin</Copyright>
    <RepositoryUrl>https://github.com/gbolotin/WpfFoundation</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The next release. Bump it in every change: each push to main is tagged v$(Version) and published by CI. -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
