<Window x:Class="WpfFoundation.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:WpfFoundation.Gallery.Pages"
        Title="WpfFoundation Gallery"
        Width="1100"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <!-- A plain ListBox sidebar until the library's navigation service and sidebar arrive in slice 4. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="Pages"
                 Margin="8"
                 SelectedIndex="0"
                 AutomationProperties.Name="Gallery pages">
            <ListBoxItem Content="Overview">
                <ListBoxItem.Tag>
                    <pages:OverviewPage />
                </ListBoxItem.Tag>
            </ListBoxItem>
            <ListBoxItem Content="Styled controls">
                <ListBoxItem.Tag>
                    <pages:StyledControlsPage />
                </ListBoxItem.Tag>
            </ListBoxItem>
            <ListBoxItem Content="Custom UI">
                <ListBoxItem.Tag>
                    <pages:CustomUiPage />
                </ListBoxItem.Tag>
            </ListBoxItem>
            <ListBoxItem Content="Behaviors">
                <ListBoxItem.Tag>
                    <pages:BehaviorsPage />
                </ListBoxItem.Tag>
            </ListBoxItem>
        </ListBox>
        <ContentControl Grid.Column="1"
                        Margin="24,16,24,16"
                        Content="{Binding SelectedItem.Tag, ElementName=Pages}"
                        Focusable="False" />
    </Grid>
</Window>
