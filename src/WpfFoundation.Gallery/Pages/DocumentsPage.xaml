<UserControl x:Class="WpfFoundation.Gallery.Pages.DocumentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WpfFoundation.Gallery.Controls"
             xmlns:documents="clr-namespace:WpfFoundation.Documents;assembly=WpfFoundation"
             xmlns:viewModels="clr-namespace:WpfFoundation.Gallery.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <!-- The views of the two document kinds. Applications usually map each to its own UserControl. -->
        <DataTemplate DataType="{x:Type viewModels:TrailListViewModel}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Text="This list is always open, so its tab has no close button. Open a trail twice: the second time activates its existing tab." />
                <ItemsControl ItemsSource="{Binding Trails}" Margin="0,12,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,8,8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding OpenCount, StringFormat=Trail documents created: {0}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TrailDocumentViewModel}">
            <StackPanel>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         MinHeight="64"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="Trail notes" />
                <CheckBox Content="Unsaved changes"
                          AutomationProperties.HelpText="Closing this tab asks first, and Keep leaves it open."
                          IsChecked="{Binding HasUnsavedChanges}"
                          Style="{StaticResource WfToggleSwitchStyle}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880"
                    Margin="0,0,16,0"
                    HorizontalAlignment="Left">
            <TextBlock Text="Document tabs" Style="{StaticResource WfHeadingTextStyle}" />
            <TextBlock TextWrapping="Wrap" Text="A document workspace keeps one tab per document key. Each tab's view is created when it is first shown and kept while other tabs are active, so notes you type survive switching tabs; closing a tab releases its view. With focus in the tabs, Ctrl+W closes the active tab and Ctrl+Tab or Ctrl+Page Down switches tabs." />

            <TextBlock Text="Trails" Style="{StaticResource WfLabelTextStyle}" />
            <Border Style="{StaticResource WfCardStyle}" Height="280">
                <documents:DocumentTabs Workspace="{Binding Workspace}" />
            </Border>

            <TextBlock Text="Cleanup when documents close" Style="{StaticResource WfLabelTextStyle}" />
            <ItemsControl ItemsSource="{Binding CleanupLog}"
                          Focusable="False"
                          AutomationProperties.Name="Cleanup log"
                          AutomationProperties.LiveSetting="Polite" />

            <controls:CodeSample Margin="0,16,0,0" Header="XAML">
                <controls:CodeSample.Code>
                    <sys:String xml:space="preserve">xmlns:documents="clr-namespace:WpfFoundation.Documents;assembly=WpfFoundation"

&lt;documents:DocumentTabs Workspace="{Binding Workspace}" /&gt;

&lt;!-- Each document's content gets its view from a DataTemplate. --&gt;
&lt;DataTemplate DataType="{x:Type local:TrailViewModel}"&gt;
    &lt;local:TrailView /&gt;
&lt;/DataTemplate&gt;</sys:String>
                </controls:CodeSample.Code>
            </controls:CodeSample>
            <controls:CodeSample Margin="0,16,0,0" Header="Workspace, guard and cleanup">
                <controls:CodeSample.Code>
                    <sys:String xml:space="preserve">var workspace = new DocumentWorkspace(guard: new SaveBeforeClosingGuard(dialogs));
workspace.DocumentClosed += (_, e) =&gt; ((TrailViewModel)e.Document.Content).Dispose();

// An always-open document has no close button.
workspace.Open(new DocumentItem("trails", "Trails", trailList) { IsClosable = false });

// Opening a key that is already open activates its tab and returns the open document.
workspace.Open(new DocumentItem(trail.Id, trail.Name, new TrailViewModel(trail)));

// IDocumentCloseGuard.ConfirmCloseAsync can save, ask or refuse. Closing the active tab activates
// its left neighbor, then its right one.</sys:String>
                </controls:CodeSample.Code>
            </controls:CodeSample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
