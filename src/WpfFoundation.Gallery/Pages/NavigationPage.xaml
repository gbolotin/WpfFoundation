<UserControl x:Class="WpfFoundation.Gallery.Pages.NavigationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WpfFoundation.Gallery.Controls"
             xmlns:wf="clr-namespace:WpfFoundation.Controls;assembly=WpfFoundation"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="880"
                    Margin="0,0,16,0"
                    HorizontalAlignment="Left">
            <TextBlock Text="Navigation" Style="{StaticResource WfHeadingTextStyle}" />
            <TextBlock TextWrapping="Wrap" Text="This Gallery uses WpfFoundation's navigation service, sidebar style and retained page host. Each page's view is created on its first visit and kept, so what you type or scroll here is still there when you come back. A navigation button and a content overlay show a frame, such as settings, over the window." />

            <TextBlock Text="Initialization" Style="{StaticResource WfLabelTextStyle}" />
            <TextBlock TextWrapping="Wrap" Text="{Binding InitializationSummary}" />

            <TextBlock Text="Retained state and blocked navigation" Style="{StaticResource WfLabelTextStyle}" />
            <Border Style="{StaticResource WfCardStyle}">
                <StackPanel>
                    <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             MinHeight="64"
                             TextWrapping="Wrap"
                             AutomationProperties.Name="Draft note" />
                    <CheckBox Content="Unsaved changes"
                              AutomationProperties.HelpText="Leaving this page asks first, and Stay keeps you here."
                              IsChecked="{Binding HasUnsavedChanges}"
                              Style="{StaticResource WfToggleSwitchStyle}" />
                    <CheckBox Content="Busy"
                              AutomationProperties.HelpText="Disables the sidebar, as a running operation would."
                              IsChecked="{Binding IsBusy}"
                              Style="{StaticResource WfToggleSwitchStyle}" />
                </StackPanel>
            </Border>

            <controls:CodeSample Margin="0,16,0,0" Header="Shell XAML">
                <controls:CodeSample.Code>
                    <sys:String xml:space="preserve">xmlns:navigation="clr-namespace:WpfFoundation.Navigation;assembly=WpfFoundation"

&lt;DockPanel&gt;
    &lt;ListBox DockPanel.Dock="Left"
             ItemsSource="{Binding Navigation.Pages}"
             SelectedItem="{Binding Navigation.CurrentPage}"
             IsEnabled="{Binding Navigation.CanNavigate}"
             Style="{StaticResource WfNavigationSidebarStyle}" /&gt;
    &lt;navigation:RetainedPageHost Navigation="{Binding Navigation}" /&gt;
&lt;/DockPanel&gt;

&lt;!-- Each page ViewModel implements INavigationPage and gets its view from a DataTemplate. --&gt;
&lt;DataTemplate DataType="{x:Type local:NotesViewModel}"&gt;
    &lt;local:NotesView /&gt;
&lt;/DataTemplate&gt;</sys:String>
                </controls:CodeSample.Code>
            </controls:CodeSample>
            <controls:CodeSample Margin="0,16,0,0" Header="Composition and guard">
                <controls:CodeSample.Code>
                    <sys:String xml:space="preserve">var navigation = new NavigationService([notes, maps, settings], guard: new SaveBeforeLeavingGuard(settings));
navigation.NavigationFailed += (_, failure) =&gt; ShowError(failure.Exception);
await navigation.NavigateAsync(notes);

// Optional page contracts:
//   IInitializeAsync  loads once before the first visit, and retries after a failure.
//   IPageActivation   refreshes on every visit.
// INavigationGuard.CanNavigate disables the sidebar; ConfirmNavigationAsync can save, ask or refuse.</sys:String>
                </controls:CodeSample.Code>
            </controls:CodeSample>

            <TextBlock Text="Navigation button and content overlay" Style="{StaticResource WfLabelTextStyle}" />
            <TextBlock TextWrapping="Wrap" Text="The Settings button at the bottom of this sidebar runs a command instead of selecting a page. It opens trail settings in a content overlay. Close it with the close button, a click outside the card or Esc. Turn on Keep open to see the overlay refuse to close." />
            <Border Height="360"
                    Margin="0,8,0,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource OverlayCornerRadius}">
                <Grid>
                    <DockPanel IsEnabled="{Binding IsOverlayOpen, Converter={StaticResource WfInverseBooleanConverter}}">
                        <Border DockPanel.Dock="Left"
                                Width="200"
                                Background="{DynamicResource ListBoxBackground}"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,1,0">
                            <DockPanel>
                                <Button Content="Settings"
                                        Tag="&#xE713;"
                                        Command="{Binding OpenOverlayCommand}"
                                        DockPanel.Dock="Bottom"
                                        Margin="8"
                                        Style="{StaticResource WfNavigationButtonStyle}" />
                                <TextBlock Text="Field notes"
                                           Margin="24,16"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </DockPanel>
                        </Border>
                        <TextBlock Text="Fog lifted over the quarry by nine. The north trail stays closed until the bridge is repaired."
                                   Margin="24,16"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                    <wf:ContentOverlay Header="Trail settings"
                                       IsOpen="{Binding IsOverlayOpen, Mode=OneWay}"
                                       CloseCommand="{Binding CloseOverlayCommand}"
                                       CardMaxWidth="480"
                                       Padding="24">
                        <StackPanel Margin="24,0,24,24">
                            <HeaderedContentControl Header="Units"
                                                    AutomationProperties.HelpText="Distances in trail notes use these units."
                                                    Style="{StaticResource WfSettingRowStyle}">
                                <ComboBox SelectedIndex="0"
                                          MinWidth="160"
                                          AutomationProperties.Name="Units">
                                    <ComboBoxItem Content="Kilometers" />
                                    <ComboBoxItem Content="Miles" />
                                </ComboBox>
                            </HeaderedContentControl>
                            <CheckBox Content="Keep open"
                                      AutomationProperties.HelpText="The overlay refuses to close, as one with an unresolved error would."
                                      IsChecked="{Binding KeepOverlayOpen}"
                                      Style="{StaticResource WfToggleSwitchStyle}" />
                        </StackPanel>
                    </wf:ContentOverlay>
                </Grid>
            </Border>
            <controls:CodeSample Margin="0,16,0,0" Header="Navigation button and overlay XAML">
                <controls:CodeSample.Code>
                    <sys:String xml:space="preserve">xmlns:wf="clr-namespace:WpfFoundation.Controls;assembly=WpfFoundation"

&lt;Grid&gt;
    &lt;!-- The covered content is disabled while the overlay is open, so keyboard and screen readers stay in the card. --&gt;
    &lt;DockPanel IsEnabled="{Binding IsSettingsOpen, Converter={StaticResource WfInverseBooleanConverter}}"&gt;
        &lt;!-- The button sits on the sidebar's background, below the pages. --&gt;
        &lt;Border DockPanel.Dock="Left"
                Background="{DynamicResource ListBoxBackground}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"&gt;
            &lt;DockPanel&gt;
                &lt;Button Content="Settings"
                        Tag="&amp;#xE713;"
                        Command="{Binding OpenSettingsCommand}"
                        DockPanel.Dock="Bottom"
                        Margin="8"
                        Style="{StaticResource WfNavigationButtonStyle}" /&gt;
                &lt;ListBox ItemsSource="{Binding Navigation.Pages}"
                         SelectedItem="{Binding Navigation.CurrentPage}"
                         Background="Transparent"
                         BorderThickness="0"
                         Style="{StaticResource WfNavigationSidebarStyle}" /&gt;
            &lt;/DockPanel&gt;
        &lt;/Border&gt;
        &lt;navigation:RetainedPageHost Navigation="{Binding Navigation}" /&gt;
    &lt;/DockPanel&gt;
    &lt;!-- CloseCommand runs for the close button, a click outside the card and Esc; it can refuse while it cannot execute.
         HeaderBackground matches the title row to a navigation pane the content starts with. --&gt;
    &lt;wf:ContentOverlay Header="Settings"
                       Content="{Binding Settings}"
                       IsOpen="{Binding IsSettingsOpen, Mode=OneWay}"
                       CloseCommand="{Binding CloseSettingsCommand}"
                       HeaderBackground="{DynamicResource ListBoxBackground}"
                       CardMaxWidth="1040"
                       CardMaxHeight="760" /&gt;
&lt;/Grid&gt;</sys:String>
                </controls:CodeSample.Code>
            </controls:CodeSample>

            <TextBlock Text="Menu in the title bar" Style="{StaticResource WfLabelTextStyle}" />
            <TextBlock TextWrapping="Wrap" Text="With the Fluent backdrop, a title bar replaces the system one: the window's icon, title and menu share the row, and Windows still draws the caption buttons. This window sets ExtendsIntoTitleBar to False, so its View menu shows below the system title bar, as it also does in high contrast." />
            <controls:CodeSample Margin="0,16,0,0" Header="Title bar XAML">
                <controls:CodeSample.Code>
                    <sys:String xml:space="preserve">xmlns:wf="clr-namespace:WpfFoundation.Controls;assembly=WpfFoundation"

&lt;Window Icon="trailnotes.ico" Title="Trail Notes"&gt;
    &lt;DockPanel&gt;
        &lt;!-- The icon, the window's title, then the menu. Leave the row transparent so the backdrop shows. --&gt;
        &lt;wf:TitleBar DockPanel.Dock="Top"&gt;
            &lt;Menu&gt;
                &lt;MenuItem Header="_File"&gt;
                    &lt;MenuItem Header="_Open..." Command="{Binding OpenCommand}" /&gt;
                    &lt;Separator /&gt;
                    &lt;MenuItem Header="E_xit" Command="{Binding ExitCommand}" /&gt;
                &lt;/MenuItem&gt;
            &lt;/Menu&gt;
        &lt;/wf:TitleBar&gt;
        &lt;Grid Background="{DynamicResource ApplicationBackgroundBrush}"&gt;
            ...
        &lt;/Grid&gt;
    &lt;/DockPanel&gt;
&lt;/Window&gt;</sys:String>
                </controls:CodeSample.Code>
            </controls:CodeSample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
