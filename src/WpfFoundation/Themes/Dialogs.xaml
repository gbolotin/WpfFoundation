<!-- Bodies of the built-in dialogs. Applications add implicit DataTemplates for their own dialog ViewModels the same way. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dialogs="clr-namespace:WpfFoundation.Dialogs">
    <DataTemplate DataType="{x:Type dialogs:MessageDialogViewModel}">
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   MaxWidth="544" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type dialogs:ConfirmationDialogViewModel}">
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   MaxWidth="544" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type dialogs:ReviewDialogViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
