<!--
    The single entry dictionary of WpfFoundation. Merge it once in App.xaml, after setting ThemeMode:
    <ResourceDictionary Source="pack://application:,,,/WpfFoundation;component/Themes/WpfFoundation.xaml" />
    Every resource key defined here starts with "Wf" and is part of the package's SemVer contract.
    Styles build on the Fluent theme's brushes, text styles and corner radius, and its 4 px spacing grid.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:WpfFoundation.Behaviors"
                    xmlns:controls="clr-namespace:WpfFoundation.Controls"
                    xmlns:converters="clr-namespace:WpfFoundation.Converters"
                    xmlns:documents="clr-namespace:WpfFoundation.Documents"
                    xmlns:navigation="clr-namespace:WpfFoundation.Navigation"
                    xmlns:cm="clr-namespace:System.ComponentModel;assembly=System.ComponentModel.TypeConverter"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WpfFoundation;component/Themes/Dialogs.xaml" />
        <ResourceDictionary Source="/WpfFoundation;component/Themes/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Converters -->
    <BooleanToVisibilityConverter x:Key="WfBooleanToVisibilityConverter" />
    <converters:InverseBooleanToVisibilityConverter x:Key="WfInverseBooleanToVisibilityConverter" />
    <converters:InverseBooleanConverter x:Key="WfInverseBooleanConverter" />
    <converters:ReferenceEqualsToVisibilityConverter x:Key="WfReferenceEqualsToVisibilityConverter" />

    <!-- Text -->
    <Style x:Key="WfHeadingTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="WfLabelTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,12,0,8" />
    </Style>

    <!-- Card: a Border on the Fluent card background. -->
    <Style x:Key="WfCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="WfPrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource AccentButtonStyle}" />
    <!--
        Text uses the Fluent primary text brush as a DynamicResource, so the button follows a theme change while
        the application runs. A StaticResource color here would keep the startup theme.
    -->
    <Style x:Key="WfTransparentButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        </Style.Resources>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--
        Subtle button: no fill or border at rest, and the Fluent subtle fills while hovered and pressed, like the subtle
        buttons in WinUI title bars and command bars. Use it for an icon command such as a close button. ContentOverlay's
        close button and WfNavigationButtonStyle build on it.
          <Button Content="&#xE711;"
                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                  AutomationProperties.Name="Close"
                  Style="{StaticResource WfSubtleButtonStyle}" />
    -->
    <Style x:Key="WfSubtleButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Icon and text button content: the button's Tag is the icon and Content is the text. The icon is a
        vector icon resource such as WfIconAddFiles, or a Segoe Fluent Icons glyph.
          <Button Content="Add files"
                  Tag="{StaticResource WfIconAddFiles}"
                  ContentTemplate="{StaticResource WfIconContentTemplate}" />
          <Button Content="Clear all"
                  Tag="&#xEA99;"
                  ContentTemplate="{StaticResource WfIconContentTemplate}" />
    -->
    <DataTemplate x:Key="WfIconContentTemplate">
        <StackPanel Orientation="Horizontal">
            <ContentPresenter Content="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center">
                <ContentPresenter.Resources>
                    <DataTemplate DataType="{x:Type Geometry}">
                        <controls:PathIcon Data="{Binding}" Size="{StaticResource DefaultIconFontSize}" />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type sys:String}">
                        <TextBlock Text="{Binding}"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="{StaticResource DefaultIconFontSize}" />
                    </DataTemplate>
                </ContentPresenter.Resources>
            </ContentPresenter>
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!--
        Split button, like the Start button in Visual Studio: the primary part runs Command and the chevron part
        opens DropDownMenu under the button. Icon is a Segoe Fluent Icons glyph, or any element, shown before Content;
        the primary part is disabled while the command cannot run, and the menu stays available. It is the default
        style of every SplitButton in an application that merges this dictionary; base a local SplitButton style on
        WfSplitButtonStyle to keep it.
          <wf:SplitButton Content="{Binding SelectedProfile.Name}"
                          Icon="&#xE768;"
                          IconForeground="{DynamicResource SystemFillColorSuccessBrush}"
                          Command="{Binding StartCommand}">
              <wf:SplitButton.DropDownMenu>
                  <ContextMenu>
                      <MenuItem Header="Fast"
                                IsCheckable="True"
                                IsChecked="True" />
                      <MenuItem Header="Thorough" IsCheckable="True" />
                  </ContextMenu>
              </wf:SplitButton.DropDownMenu>
          </wf:SplitButton>
    -->
    <Style x:Key="WfSplitButtonStyle" TargetType="controls:SplitButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IconForeground" Value="{DynamicResource ButtonForeground}" />
        <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SplitButton">
                    <ControlTemplate.Resources>
                        <converters:CornerRadiusSideConverter x:Key="LeftCorners" Side="Left" />
                        <converters:CornerRadiusSideConverter x:Key="RightCorners" Side="Right" />
                    </ControlTemplate.Resources>
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- The chevron part draws the 1 px divider with its left border. -->
                        <Button x:Name="PART_PrimaryButton"
                                Command="{TemplateBinding Command}"
                                CommandParameter="{TemplateBinding CommandParameter}"
                                CommandTarget="{TemplateBinding CommandTarget}"
                                BorderThickness="1,1,0,1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Border.CornerRadius" Value="{Binding (Border.CornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LeftCorners}}" />
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter x:Name="IconPresenter"
                                                  Content="{TemplateBinding Icon}"
                                                  TextElement.FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                  TextElement.FontSize="{StaticResource DefaultIconFontSize}"
                                                  TextElement.Foreground="{TemplateBinding IconForeground}"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center" />
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- One tab stop, as in WinUI: the keyboard opens the menu with Alt+Down or F4 from the primary part. -->
                        <Button x:Name="PART_DropDownButton"
                                Grid.Column="1"
                                Focusable="False"
                                IsTabStop="False"
                                Padding="8,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AutomationProperties.Name="More options">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Border.CornerRadius" Value="{Binding (Border.CornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RightCorners}}" />
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{StaticResource ComboBoxChevronDownGlyph}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="{StaticResource ComboBoxChevronSize}"
                                       VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger SourceName="PART_PrimaryButton" Property="IsEnabled" Value="False">
                            <Setter TargetName="IconPresenter" Property="TextElement.Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
                        </Trigger>
                        <!-- While the menu is open the chevron stays pressed, and a click on it only closes the menu. -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="PART_DropDownButton" Property="Background" Value="{DynamicResource ButtonBackgroundPressed}" />
                            <Setter TargetName="PART_DropDownButton" Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                        <!-- Without a menu it is a plain button with all four corners rounded. -->
                        <Trigger Property="DropDownMenu" Value="{x:Null}">
                            <Setter TargetName="PART_DropDownButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_PrimaryButton" Property="BorderThickness" Value="1" />
                            <Setter TargetName="PART_PrimaryButton" Property="Border.CornerRadius" Value="{Binding (Border.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="controls:SplitButton" BasedOn="{StaticResource WfSplitButtonStyle}" />

    <!--
        Setting row with any control: Header is the title, AutomationProperties.HelpText is the
        description under it, and Content (the control) sits on the right.
          <HeaderedContentControl Header="App theme"
                                  AutomationProperties.HelpText="Select the color theme."
                                  Style="{StaticResource WfSettingRowStyle}">
              <ComboBox ... />
          </HeaderedContentControl>
    -->
    <Style x:Key="WfSettingRowStyle" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                            <ContentPresenter ContentSource="Header" />
                            <TextBlock x:Name="Description"
                                       Text="{TemplateBinding AutomationProperties.HelpText}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.HelpText" Value="">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="Description" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Setting row for wide controls such as folder paths: Content spans the row under the description. -->
    <Style x:Key="WfStackedSettingRowStyle"
           TargetType="HeaderedContentControl"
           BasedOn="{StaticResource WfSettingRowStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel Margin="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" />
                        <TextBlock x:Name="Description"
                                   Text="{TemplateBinding AutomationProperties.HelpText}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,0" />
                        <ContentPresenter Margin="0,8,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.HelpText" Value="">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="Description" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Note shown under a setting row; dims with the row when the setting is disabled. -->
    <Style x:Key="WfSettingNoteTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,-8,88,12" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        On/off setting row: Content is the title, AutomationProperties.HelpText is shown as the
        description under it (and read by screen readers), and the switch sits on the right.
        It stays a CheckBox, so keyboard behavior and accessibility are unchanged.
        Colors follow the WinUI ToggleSwitch theme resources.
          <CheckBox Content="Scan added files"
                    AutomationProperties.HelpText="Starts a scan as soon as files are added."
                    IsChecked="{Binding ScanAddedFiles}"
                    Style="{StaticResource WfToggleSwitchStyle}" />
    -->
    <Style x:Key="WfToggleSwitchStyle"
           TargetType="CheckBox"
           BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,12" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                <ContentPresenter RecognizesAccessKey="True" />
                                <TextBlock x:Name="Description"
                                           Text="{TemplateBinding AutomationProperties.HelpText}"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="State"
                                           Text="Off"
                                           MinWidth="24"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <Grid Width="40" Height="20">
                                    <Border x:Name="Track"
                                            CornerRadius="10"
                                            BorderThickness="1"
                                            Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                                    <Ellipse x:Name="Knob"
                                             Width="12"
                                             Height="12"
                                             HorizontalAlignment="Left"
                                             Margin="4,0,0,0"
                                             Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AutomationProperties.HelpText" Value="">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ControlAltFillColorTertiaryBrush}" />
                            <Setter TargetName="Knob" Property="Width" Value="14" />
                            <Setter TargetName="Knob" Property="Height" Value="14" />
                            <Setter TargetName="Knob" Property="Margin" Value="3,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ControlAltFillColorQuarternaryBrush}" />
                            <Setter TargetName="Knob" Property="Width" Value="17" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="State" Property="Text" Value="On" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <Setter TargetName="Knob" Property="Width" Value="14" />
                            <Setter TargetName="Knob" Property="Height" Value="14" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="Description" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ControlAltFillColorDisabledBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Status bar for StatusItem entries: items wrap, are separated by dividers, trim long text into a
        tooltip, and items with a Command show as link-style buttons. Other item types use their own
        DataTemplates, which the application adds to the StatusBar's resources.
          <StatusBar ItemsSource="{Binding StatusItems}"
                     DockPanel.Dock="Bottom"
                     Style="{StaticResource WfStatusBarStyle}" />
    -->
    <Style x:Key="WfStatusBarStyle" TargetType="StatusBar">
        <Style.Resources>
            <Style x:Key="WfStatusTextStyle" TargetType="TextBlock">
                <Setter Property="Text" Value="{Binding Text}" />
                <Setter Property="MaxWidth" Value="320" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEmphasized}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="WfStatusTextTemplate" DataType="{x:Type controls:StatusItem}">
                <TextBlock Style="{StaticResource WfStatusTextStyle}" ToolTip="{Binding ToolTipText}" />
            </DataTemplate>
            <DataTemplate x:Key="WfStatusCommandTemplate" DataType="{x:Type controls:StatusItem}">
                <Button Style="{StaticResource WfTransparentButtonStyle}"
                        Command="{Binding Command}"
                        ToolTip="{Binding ToolTipText}"
                        AutomationProperties.Name="{Binding Text}"
                        Padding="0"
                        MinHeight="0">
                    <TextBlock Style="{StaticResource WfStatusTextStyle}" TextDecorations="Underline" />
                </Button>
            </DataTemplate>
            <DataTemplate DataType="{x:Type controls:StatusItem}">
                <ContentControl Content="{Binding}" Focusable="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource WfStatusCommandTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Command}" Value="{x:Null}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource WfStatusTextTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </DataTemplate>
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="AutomationProperties.Name" Value="Status" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="StatusBarItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,0,12,0" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                    <Setter Property="Margin" Value="8" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Grid splitter whose grip shows only while the pointer is over it, while it is dragged, or while it has
        keyboard focus, like the WinUI and Windows Settings splitters. The rest of the time the splitter is a plain
        gap. The grip is the Fluent template's thumb, which is filled with Foreground. It is the default style of
        every GridSplitter in an application that merges this dictionary, so a plain splitter gets it:
          <GridSplitter Grid.Column="1" ResizeBehavior="PreviousAndNext" />
        Base a local GridSplitter style on WfGridSplitterStyle to keep the behavior.
    -->
    <Style x:Key="WfGridSplitterStyle"
           TargetType="GridSplitter"
           BasedOn="{StaticResource DefaultGridSplitterStyle}">
        <Setter Property="Foreground" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GridsplitterForeground}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GridsplitterForeground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GridsplitterForeground}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="GridSplitter" BasedOn="{StaticResource WfGridSplitterStyle}" />

    <!--
        Sortable GridView lists. Usage:
          <ListView behaviors:GridViewSort.Sort="{Binding MySort}">      (MySort is a ColumnSort<TItem>)
            <GridView ColumnHeaderContainerStyle="{StaticResource WfSortableColumnHeaderContainerStyle}"
                      ColumnHeaderTemplate="{StaticResource WfSortableColumnHeaderTemplate}">
              <GridViewColumn Header="Name" behaviors:GridViewSort.Key="{x:Static local:MyColumn.Name}" />
        Columns with their own HeaderTemplate put <TextBlock Style="{StaticResource WfColumnSortIndicatorStyle}" />
        in a Grid cell together with the header content, as WfSortableColumnHeaderTemplate does.
        Like Windows Explorer, the indicator is centered above the header text.
    -->
    <Style x:Key="WfSortableColumnHeaderContainerStyle"
           TargetType="GridViewColumnHeader"
           BasedOn="{StaticResource DefaultGridViewColumnHeaderStyle}">
        <!-- Stretch the content so the indicator can sit top-center over the whole column. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="WfColumnSortIndicatorStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <!-- Pull up into the header's top padding so the icon sits at the top edge and does not grow the header. -->
        <Setter Property="Margin" Value="0,-2,0,0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="behaviors:GridViewSort.ShowsColumnDirection" Value="True" />
        <Style.Triggers>
            <Trigger Property="behaviors:GridViewSort.Direction" Value="{x:Static cm:ListSortDirection.Ascending}">
                <Setter Property="Text" Value="&#xE70E;" />
                <Setter Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="behaviors:GridViewSort.Direction" Value="{x:Static cm:ListSortDirection.Descending}">
                <Setter Property="Text" Value="&#xE70D;" />
                <Setter Property="Visibility" Value="Visible" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="WfSortableColumnHeaderTemplate">
        <Grid Margin="1,0,0,0">
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource WfColumnSortIndicatorStyle}" />
        </Grid>
    </DataTemplate>

    <!--
        Navigation sidebar: a ListBox of INavigationPage items with icon and name. Bind it to an INavigationService;
        a rejected navigation returns the selection to the current page. Like the WinUI NavigationView, the selected
        page has a rounded subtle fill and an accent pill on its left edge.
          <ListBox ItemsSource="{Binding Navigation.Pages}"
                   SelectedItem="{Binding Navigation.CurrentPage}"
                   IsEnabled="{Binding Navigation.CanNavigate}"
                   Style="{StaticResource WfNavigationSidebarStyle}" />
          <navigation:RetainedPageHost Navigation="{Binding Navigation}" />
    -->
    <Style x:Key="WfNavigationSidebarStyle"
           TargetType="ListBox"
           BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="AutomationProperties.Name" Value="Navigation" />
        <!--
            Items use the WinUI NavigationViewItem fills. The pill uses the Fluent ListView pill brush, which is the
            accent color in Light and Dark and the system highlight color in high contrast.
        -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Margin" Value="0,2" />
                    <Setter Property="Padding" Value="12,8" />
                    <!-- Screen readers announce the page name instead of the page ViewModel's type name. -->
                    <Setter Property="AutomationProperties.Name" Value="{Binding NavigationName}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Rectangle x:Name="SelectionPill"
                                                   Width="3"
                                                   Height="16"
                                                   RadiusX="1.5"
                                                   RadiusY="1.5"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Fill="{DynamicResource ListViewItemPillFillBrush}"
                                                   Visibility="Collapsed" />
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        <Setter TargetName="SelectionPill" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                    </MultiTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                        <Setter TargetName="SelectionPill" Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NavigationIcon}"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="{StaticResource DefaultIconFontSize}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{Binding NavigationName}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Navigation button: a command in the navigation sidebar that does not select a page, such as Settings at the
        bottom. It looks like the sidebar's items, without a selected state; Tag is its icon and Content its name, as
        in WfIconContentTemplate. The sidebar ListBox draws its own background and divider, so a sidebar with a button
        below its pages moves both to a Border around them, and the button sits on the same background as the pages:
          <Border DockPanel.Dock="Left"
                  Background="{DynamicResource ListBoxBackground}"
                  BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,1,0">
              <DockPanel>
                  <Button Content="Settings"
                          Tag="&#xE713;"
                          Command="{Binding OpenSettingsCommand}"
                          DockPanel.Dock="Bottom"
                          Margin="8"
                          Style="{StaticResource WfNavigationButtonStyle}" />
                  <ListBox ItemsSource="{Binding Navigation.Pages}"
                           SelectedItem="{Binding Navigation.CurrentPage}"
                           Background="Transparent"
                           BorderThickness="0"
                           Style="{StaticResource WfNavigationSidebarStyle}" />
              </DockPanel>
          </Border>
    -->
    <Style x:Key="WfNavigationButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource WfSubtleButtonStyle}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ContentTemplate" Value="{StaticResource WfIconContentTemplate}" />
    </Style>

    <!-- A document's view is the view of its content, so a RetainedPageHost shows it like any other page. -->
    <DataTemplate DataType="{x:Type documents:DocumentItem}">
        <ContentPresenter Content="{Binding Content}" />
    </DataTemplate>

    <!--
        Document tab strip: a horizontal ListBox of DocumentItem tabs, each with its title and, when the document is
        closable, a close button. Like the sidebar, the selected tab has a subtle fill and an accent pill, here along
        its bottom edge. DocumentTabs uses it above a RetainedPageHost; use it directly only for a custom layout:
          <ListBox ItemsSource="{Binding Workspace.Documents}"
                   SelectedItem="{Binding Workspace.CurrentPage}"
                   Style="{StaticResource WfDocumentTabStripStyle}" />
          <navigation:RetainedPageHost Navigation="{Binding Workspace}" />
    -->
    <Style x:Key="WfDocumentTabStripStyle"
           TargetType="ListBox"
           BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,0,0,4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="AutomationProperties.Name" Value="Documents" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                        <Rectangle x:Name="SelectionPill"
                                                   Width="16"
                                                   Height="3"
                                                   RadiusX="1.5"
                                                   RadiusY="1.5"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   Fill="{DynamicResource ListViewItemPillFillBrush}"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        <Setter TargetName="SelectionPill" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                    </MultiTrigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                        <Setter TargetName="SelectionPill" Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type documents:DocumentItem}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        <Button x:Name="CloseButton"
                                Command="{Binding CloseCommand}"
                                ToolTip="Close"
                                AutomationProperties.Name="{Binding Title, StringFormat=Close {0}}"
                                Focusable="False"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Border"
                                            Background="Transparent"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="4">
                                        <TextBlock Text="&#xE711;"
                                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsClosable}" Value="False">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Document tabs: the tab strip of a DocumentWorkspace above a RetainedPageHost, which keeps each open document's view
        while another is active. Each document's Content needs an implicit DataTemplate. While focus is inside, Ctrl+W
        closes the active document, and Ctrl+Tab, Ctrl+Shift+Tab, Ctrl+Page Down and Ctrl+Page Up switch documents.
        It is the default style of every DocumentTabs in an application that merges this dictionary; base a local
        DocumentTabs style on WfDocumentTabsStyle to keep it.
          <documents:DocumentTabs Workspace="{Binding Workspace}" />
    -->
    <Style x:Key="WfDocumentTabsStyle" TargetType="documents:DocumentTabs">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="documents:DocumentTabs">
                    <DockPanel Background="{TemplateBinding Background}">
                        <ListBox x:Name="PART_TabStrip"
                                 DockPanel.Dock="Top"
                                 ItemsSource="{Binding Workspace.Documents, RelativeSource={RelativeSource TemplatedParent}}"
                                 SelectedItem="{Binding Workspace.CurrentPage, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                 Style="{StaticResource WfDocumentTabStripStyle}" />
                        <navigation:RetainedPageHost Navigation="{TemplateBinding Workspace}"
                                                Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="0,12,0,0" />
    </Style>
    <Style TargetType="documents:DocumentTabs" BasedOn="{StaticResource WfDocumentTabsStyle}" />

    <!--
        Content overlay: a card over a window's content, such as a settings frame, on a smoke layer that covers everything
        around it. The close button, a click on the smoke and Esc close it: they run CloseCommand when it is set, which
        can refuse while it cannot execute, and otherwise set IsOpen to false. Opening moves focus into the content and
        keeps Tab inside the card; closing returns focus where it was. Padding is the smoke margin around the card, which
        grows up to CardMaxWidth and CardMaxHeight. Disable the content it covers while it is open:
          <Grid>
              <DockPanel IsEnabled="{Binding IsSettingsOpen, Converter={StaticResource WfInverseBooleanConverter}}">
                  ...
              </DockPanel>
              <wf:ContentOverlay Header="Settings"
                                 Content="{Binding Settings}"
                                 IsOpen="{Binding IsSettingsOpen, Mode=OneWay}"
                                 CloseCommand="{Binding CloseSettingsCommand}"
                                 CardMaxWidth="1040"
                                 CardMaxHeight="760" />
          </Grid>
        It is the default style of every ContentOverlay in an application that merges this dictionary; base a local
        ContentOverlay style on WfContentOverlayStyle to keep it.
    -->
    <Style x:Key="WfContentOverlayStyle" TargetType="controls:ContentOverlay">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Padding" Value="48" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ContentOverlay">
                    <Grid>
                        <Border x:Name="PART_Smoke" Background="{DynamicResource SmokeFillColorDefaultBrush}" />
                        <Border x:Name="PART_Card"
                                Margin="{TemplateBinding Padding}"
                                MaxWidth="{TemplateBinding CardMaxWidth}"
                                MaxHeight="{TemplateBinding CardMaxHeight}"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource OverlayCornerRadius}"
                                KeyboardNavigation.TabNavigation="Cycle"
                                KeyboardNavigation.ControlTabNavigation="Cycle"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                AutomationProperties.IsDialog="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- The content comes before the header in the tab order, so opening focuses it rather than the close button. -->
                                <ContentPresenter Grid.Row="1" ContentSource="Content" />
                                <DockPanel Margin="24,16,12,8">
                                    <Button Content="&#xE711;"
                                            Command="ApplicationCommands.Close"
                                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                            DockPanel.Dock="Right"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            ToolTip="Close"
                                            AutomationProperties.Name="Close"
                                            Style="{StaticResource WfSubtleButtonStyle}" />
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center">
                                        <ContentPresenter.Resources>
                                            <DataTemplate DataType="{x:Type sys:String}">
                                                <TextBlock Text="{Binding}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{StaticResource SubtitleTextBlockStyle}" />
                                            </DataTemplate>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsOpen" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="controls:ContentOverlay" BasedOn="{StaticResource WfContentOverlayStyle}" />
</ResourceDictionary>
